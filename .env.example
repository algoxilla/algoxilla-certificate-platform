# ==============================================================================
# Algoxilla Certificate Platform - Environment Configuration Template
# ==============================================================================
# SAFE TEMPLATE: Contains variable definitions and safe placeholders only.
# NEVER commit real credentials, API keys, database passwords, or secrets to Git.
#
# Usage:
#   1. Copy this file to `.env.local` for local development or staging.
#   2. Populate with approved project credentials in your secure hosting dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL & QR Verification Domain Safeguard
# ------------------------------------------------------------------------------
# Public URL used to generate single-use claim links and default portal links.
# Development default: http://localhost:3000
# Production target:   https://verify.algoxilla.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dedicated QR Verification Public Base URL
# Controls the exact URL embedded in certificate QR codes.
# Overrides NEXT_PUBLIC_APP_URL for verification codes.
# Keep set to http://localhost:3000 or staging until DNS & SSL for verify.algoxilla.com are verified!
NEXT_PUBLIC_VERIFY_BASE_URL=http://localhost:3000

# Production Live Guard (CRITICAL SERVER-ONLY SAFETY SWITCH)
# Set to 'false' to preserve sandbox/demo protections and synthetic data notices.
# Set to 'true' ONLY after organizer approval, full staging checks, and production verification.
# When true, Rule 9 strictly enforces fail-closed behavior (no mock fallback).
# Note: Kept strictly server-side (no NEXT_PUBLIC_ prefix) for Vercel Secret compatibility.
APP_LIVE=false

# ------------------------------------------------------------------------------
# 2. Production Database (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Authoritative database connection string or Supabase project credentials.
# Required in production mode. If missing or disconnected when APP_LIVE=true,
# the platform fails closed (HTTP 503) to prevent issuing incorrect certificates.
#
# Supabase Transaction Pooler URL (Recommended for serverless Next.js, Port 6543):
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Used for direct DDL migrations / schema setup, Port 5432):
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase API REST / Realtime credentials (alternative/complement to DATABASE_URL):
SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# CRITICAL: Keep SUPABASE_SERVICE_ROLE_KEY strictly server-side (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ------------------------------------------------------------------------------
# 3. Cryptographic Authentication & Session Secrets
# ------------------------------------------------------------------------------
# Secret key used for signing stateless HTTP-only participant session cookies (algo_claim_session).
# Must be a cryptographically random string with at least 32 bytes of entropy.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# Dedicated HMAC secret used to hash single-use claim tokens before database persistence.
# Raw tokens are never stored in plaintext. (Falls back to AUTH_SECRET if omitted).
CLAIM_TOKEN_SECRET="replace-with-a-dedicated-random-32-byte-hex-token-secret"

# Administrative authorization secret passed via the 'x-organizer-secret' header.
# Used for organizer-authorized actions and administrative operations.
ORGANIZER_SECRET="replace-with-a-secure-organizer-secret"

# ------------------------------------------------------------------------------
# 4. Transactional Email Provider (Brevo REST API v3)
# ------------------------------------------------------------------------------
# Brevo API Key (starts with 'xkeysib-...') configured in Brevo Dashboard -> SMTP & API.
# In local development without this key, dispatches are safely simulated in test mode.
BREVO_API_KEY="xyour-brevo-api-key"

# Approved sender email address and display name.
# Sender domain (algoxilla.com) must be verified with SPF/DKIM/DMARC in Brevo for high deliverability.
EMAIL_FROM="Algoxilla Certifications <certificates@algoxilla.com>"

# ------------------------------------------------------------------------------
# 5. Staging & Pilot Test Email Allowlist
# ------------------------------------------------------------------------------
# Comma-separated list of exact designated test inboxes permitted when APP_LIVE=false.
# All other recipients are strictly suppressed without making network requests.
TEST_EMAIL_ALLOWLIST="devns.test@algoxilla.com,staging-test@algoxilla.com,pilot.test@example.com"
