# Algoxilla Certificate Platform - Environment Template
# Note: In Phase 1, no real backend, database, or email service is connected.
# All data rendered in the UI is strictly mock data.
# Real credentials will be provided in subsequent phases (Phase 2 & Phase 3).

# Public Application URL (Used for verification QR codes and redirect links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Planned for Phase 2)
# DATABASE_URL="postgresql://user:password@localhost:5432/algoxilla_certificates"

# Authentication & Session Secrets (Planned for Phase 3)
# AUTH_SECRET="your-32-character-secret-key"

# Email Provider Configuration (Planned for Phase 3 - OTP delivery)
# RESEND_API_KEY=""
# EMAIL_FROM="Algoxilla Certifications <certificates@algoxilla.com>"
