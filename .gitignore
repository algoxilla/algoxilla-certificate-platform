# Algoxilla Certificate Platform - .gitignore
# Excludes environment secrets, dependencies, build output, and real participant data.

# Local investigation and generated test artifacts
/scratch/
/test/output/

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage

# Next.js & Turbopack build outputs
/.next/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# Production artifacts
dist/

# Environment secrets & credentials
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.p12
*.pfx

# Real Participant Data & Spreadsheets (Strict Privacy Isolation)
*.xlsx
*.xls
*.csv
*.tsv
*Responses*
*responses*
*Participant*Data*
*participant*data*
/data/private/
/data/raw/
/data/participants/
/data/
*.db
*.sqlite

# Debug and system logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating System & IDE files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Deployment & Vercel
.vercel
